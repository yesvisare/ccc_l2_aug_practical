# M5.4: Vector Index Management - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ============================================
# PINECONE (Required)
# ============================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp

# ============================================
# AWS S3 (Required for backup functionality)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=vector-index-backups

# ============================================
# REDIS (Required for blue-green coordination)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Defaults & Configuration
# ============================================
DEFAULT_BATCH_SIZE=1000
DEFAULT_DIMENSION=1536
DEFAULT_METRIC=cosine
BACKUP_RETENTION_DAYS=30

# ============================================
# Cost Tracking (Override if pricing changes)
# ============================================
# COST_PER_MILLION_QUERIES=0.10
# COST_PER_MILLION_UPSERTS=0.20
# COST_PER_GB_STORAGE_MONTHLY=0.30
# COST_PER_GB_TRANSFER=0.09
