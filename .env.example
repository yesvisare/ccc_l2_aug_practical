# Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Environment (dev/staging/prod)
ENVIRONMENT=dev

# Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT_POINT=secret

# Fallback credentials (used if Vault is unavailable)
# In production, these should NOT be set (rely on Vault only)
OPENAI_API_KEY=sk-your-openai-key-here
PINECONE_API_KEY=your-pinecone-key-here
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_ROTATION=true
ENABLE_METRICS=true
FALLBACK_TO_ENV=true

# Rotation Settings
ROTATION_INTERVAL_HOURS=720  # 30 days
ROTATION_GRACE_PERIOD=5  # seconds

# Cache Settings
SECRET_CACHE_TTL=300  # 5 minutes
SECRET_CACHE_MAXSIZE=128

# Monitoring
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
