# Module 8.4: Human-in-the-Loop Evaluation Configuration

# Database
DB_PATH=feedback.db

# Active Learning Parameters
UNCERTAINTY_WEIGHT=0.5
NEGATIVE_FEEDBACK_BOOST=0.5
N_SELECT_DAILY=50
N_DIVERSITY_CLUSTERS=10

# Inter-Annotator Agreement
MIN_IAA_THRESHOLD=0.70

# Feedback Loop
MIN_CONFIDENCE_FOR_TRAINING=0.7
FEEDBACK_RESPONSE_RATE_TARGET=0.05

# Label Studio Configuration (Optional)
# Sign up at https://labelstud.io/ or self-host
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=your_label_studio_api_key_here
LABEL_STUDIO_PROJECT_ID=1

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Monitoring
ENABLE_METRICS=false
