# M5.3: Data Quality & Validation - Environment Configuration

# ==================================================================
# Quality Scoring Configuration
# ==================================================================
# Minimum quality score threshold (0-100)
MIN_QUALITY_SCORE=70.0

# Optimal chunk length range in characters
OPTIMAL_LENGTH_MIN=200
OPTIMAL_LENGTH_MAX=800

# ==================================================================
# Duplicate Detection Configuration
# ==================================================================
# Jaccard similarity threshold for duplicates (0-1)
# Standard: 0.85 for near-duplicates
# Higher (0.95): stricter, fewer false positives, more false negatives
SIMILARITY_THRESHOLD=0.85

# Number of MinHash permutations (higher = more accurate, slower)
# Standard: 128 for good balance
NUM_PERMUTATIONS=128

# ==================================================================
# Data Drift Detection Configuration
# ==================================================================
# P-value threshold for statistical significance
SIGNIFICANCE_LEVEL=0.05

# Minimum distribution shift to consider drift (0-1)
# Standard: 0.15 (15% distribution shift)
DRIFT_THRESHOLD=0.15

# Minimum samples required for drift detection
MIN_DRIFT_SAMPLES=50

# ==================================================================
# Alert Thresholds (Production Monitoring)
# ==================================================================
# Minimum acceptable quality pass rate (%)
ALERT_MIN_PASS_RATE=60.0

# Maximum acceptable drift score before alerting
ALERT_MAX_DRIFT_SCORE=0.25

# Maximum acceptable deduplication rate (%) before alerting
# Alert if dedup rate > 25% (possible issue with source data)
ALERT_MAX_DEDUP_RATE=25.0

# Maximum pipeline duration in minutes before alerting
ALERT_MAX_PIPELINE_MINUTES=45

# ==================================================================
# Monitoring & Metrics
# ==================================================================
# Enable Prometheus metrics export
ENABLE_PROMETHEUS=false

# Prometheus metrics port
PROMETHEUS_PORT=8000

# Batch interval for metric flushes (seconds)
# Standard: 60s to avoid per-chunk overhead
METRICS_BATCH_INTERVAL_SECONDS=60

# ==================================================================
# Processing Settings
# ==================================================================
# Enable multiprocessing for quality scoring
ENABLE_MULTIPROCESSING=false

# Number of worker processes (8 workers = ~8x speedup for 50K+ chunks)
NUM_WORKERS=8

# Batch size for processing
BATCH_SIZE=1000

# ==================================================================
# External Service Credentials (Optional)
# ==================================================================
# Grafana (for dashboards)
GRAFANA_API_KEY=your_grafana_api_key_here
GRAFANA_URL=https://your-grafana-instance.com

# Airflow (for pipeline orchestration)
AIRFLOW_API_KEY=your_airflow_api_key_here
AIRFLOW_URL=https://your-airflow-instance.com

# ==================================================================
# Notes
# ==================================================================
# - All external service credentials are OPTIONAL
# - The system will gracefully skip integrations if credentials are missing
# - For production: copy this file to .env and fill in your actual values
# - Never commit .env file with real credentials to version control
