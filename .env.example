# Module 6.1: PII Detection & Redaction Configuration

# PII Detection Settings
PII_CONFIDENCE_THRESHOLD=0.5
PII_REDACTION_STRATEGY=replacement  # Options: masking, replacement, hashing

# Processing Settings
MAX_WORKERS=4
ENABLE_PARALLEL_PROCESSING=true

# Logging
LOG_LEVEL=INFO
ENABLE_LOG_MASKING=true

# Optional: External Services (for managed alternatives)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# Optional: Google Cloud DLP
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# GCP_PROJECT_ID=your_project_id

# Optional: Metrics
ENABLE_METRICS=false
METRICS_PORT=9090
