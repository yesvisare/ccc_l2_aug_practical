# M6.3: RBAC & Multi-Level Access Control Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration (Required)
# PostgreSQL connection string format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://rbac_user:your_password@localhost:5432/rbac_db

# Pinecone Configuration (Required for document filtering)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=rbac-docs

# Redis Configuration (Optional - for permission caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RBAC Settings
CASBIN_MODEL_PATH=
PERMISSION_CACHE_TTL=300

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Monitoring (Optional)
ENABLE_METRICS=false
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
