# Module 7.1: Distributed Tracing with OpenTelemetry
# Environment Configuration Template

# Service Identification
SERVICE_NAME=rag-compliance-copilot
SERVICE_VERSION=2.0.0
ENVIRONMENT=development  # development, staging, production

# OpenTelemetry OTLP Configuration
# Jaeger OTLP gRPC endpoint (default: localhost:4317)
OTLP_ENDPOINT=http://localhost:4317
OTLP_INSECURE=true  # Set to false in production with TLS

# Trace Sampling Configuration
# Recommended values from script:
#   Development: 1.0 (100%) - trace everything
#   Staging: 0.5 (50%) - balance visibility and cost
#   Production: 0.1 (10%) - reduce overhead from 15ms to 1.5ms
SAMPLING_RATE=1.0

# BatchSpanProcessor Configuration
# Trade-offs:
#   - Higher MAX_QUEUE_SIZE: More buffering, less blocking, more memory (~5KB per span)
#   - Higher MAX_EXPORT_BATCH_SIZE: Fewer network calls, batching efficiency
#   - Lower SCHEDULE_DELAY_MILLIS: Faster trace visibility, more network calls
MAX_QUEUE_SIZE=2048
MAX_EXPORT_BATCH_SIZE=512
SCHEDULE_DELAY_MILLIS=5000  # Export every 5 seconds

# Jaeger UI URL (for reference)
JAEGER_UI_URL=http://localhost:16686

# Enable/Disable Tracing (graceful degradation)
TRACING_ENABLED=true

# FastAPI Application Settings
APP_NAME=RAG Tracing Demo
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Settings (comma-separated)
CORS_ORIGINS=*

# RAG Pipeline Defaults
DEFAULT_TOP_K=10  # Number of documents to retrieve
DEFAULT_TOP_N=5   # Number of documents to rerank
DEFAULT_MODEL=gpt-4

# Production Notes:
# 1. Set OTLP_INSECURE=false and configure TLS certificates
# 2. Reduce SAMPLING_RATE to 0.1 for production (10% sampling)
# 3. Configure retention policy in Jaeger:
#    docker run ... -e BADGER_TTL=168h -e BADGER_MAINTENANCE_INTERVAL=1h
# 4. Monitor disk usage and set alerts at 80%
# 5. Consider Elasticsearch backend for >10K traces/day
