# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=audit-logs

# Audit Logging Configuration
AUDIT_ENABLE_HASH_CHAIN=true
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL=30

# Data Retention Configuration (in days)
RETENTION_CONFIDENTIAL=2555  # 7 years
RETENTION_INTERNAL=1095      # 3 years
RETENTION_PUBLIC=365         # 1 year
RETENTION_SECURITY_CRITICAL=3650  # 10 years

# GDPR Configuration
GDPR_EXPORT_TIMEOUT_DAYS=30
GDPR_DELETION_DELAY_DAYS=7

# Application Configuration
APP_NAME=compliance-audit-logger
APP_ENV=development
LOG_LEVEL=INFO
