# Module 8.3: Regression Testing & CI/CD Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# OpenAI Configuration
# ============================================================================
# Required for RAG query generation and evaluation
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================================================
# AWS Configuration (for DVC S3 remote storage)
# ============================================================================
# Required for model versioning with DVC
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-dvc-bucket-name

# ============================================================================
# GitHub Configuration (for CI/CD)
# ============================================================================
# Required for GitHub Actions integration
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_REPOSITORY=your-username/your-repo-name

# ============================================================================
# Application Configuration
# ============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# Optional: Testing Configuration Overrides
# ============================================================================
# Override default test subset size (default: 50)
# TEST_SUBSET_SIZE=50

# Override threshold values (defaults from script)
# FAITHFULNESS_THRESHOLD=0.75
# ANSWER_RELEVANCY_THRESHOLD=0.70
# CONTEXT_PRECISION_THRESHOLD=0.65
# P95_LATENCY_THRESHOLD_MS=2000
# COST_PER_QUERY_THRESHOLD=0.01
