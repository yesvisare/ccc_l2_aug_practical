# OpenAI API Key (required for RAGAS LLM-as-judge)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-3.5-turbo  # or gpt-4 for higher accuracy

# MLflow Configuration (optional)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ragas_evaluation

# Evaluation Configuration
GOLDEN_SET_DIR=./golden_sets
RESULTS_DIR=./evaluation_results
CHECKPOINT_DIR=./checkpoints

# Evaluation Thresholds (domain-specific)
DOMAIN=general  # general, compliance, customer_support
FAITHFULNESS_THRESHOLD=0.70
ANSWER_RELEVANCY_THRESHOLD=0.70
CONTEXT_PRECISION_THRESHOLD=0.70
CONTEXT_RECALL_THRESHOLD=0.70

# Pipeline Configuration
BATCH_SIZE=20
EVALUATION_TIMEOUT=600  # seconds
RATE_LIMIT_DELAY=2  # seconds between batches

# Cost Limits (optional safety)
MAX_MONTHLY_COST_USD=200
ALERT_THRESHOLD_COST_USD=150
