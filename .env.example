# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_METRIC_NAME=http_request_duration_seconds

# PagerDuty Configuration
PAGERDUTY_API_KEY=your_pagerduty_api_key_here
PAGERDUTY_SERVICE_ID=your_service_id_here
PAGERDUTY_INTEGRATION_KEY=your_integration_key_here

# Anomaly Detection Settings
ANOMALY_STD_THRESHOLD=3.0
ANOMALY_INTERVAL_WIDTH=0.997
ANOMALY_SEASONALITY_MODE=multiplicative

# Alert Aggregation Settings
ALERT_AGGREGATION_WINDOW=300
ALERT_AGGREGATION_ENABLED=true

# Auto-Remediation Settings
AUTO_REMEDIATION_ENABLED=false
RUNBOOK_PATH=./runbooks

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
