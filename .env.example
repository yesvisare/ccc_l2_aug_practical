# Module 7.3: Custom Business Metrics Configuration
# ===================================================
# Copy this file to .env and fill in your values

# General Configuration
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000
PROMETHEUS_PATH=/metrics
# Optional: Push Gateway for batch jobs
PROMETHEUS_PUSH_GATEWAY_URL=

# Redis Configuration (for fast cohort lookups)
# Set REDIS_ENABLED=true if you have Redis available
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# ClickHouse Configuration (optional, for >100K queries/month)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=rag_metrics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Business Metrics Configuration
COHORT_LOOKUP_MAX_MS=10.0
MAX_LABEL_CARDINALITY=100
HALLUCINATION_ALERT_THRESHOLD=5.0
POWER_USER_QUERY_THRESHOLD=100
AVG_QUERY_COST_DOLLARS=0.005

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=true
